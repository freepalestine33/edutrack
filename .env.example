# Supabase / Database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="public-anon-key"

# Server-side only (DO NOT expose in client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# Postgres connection for Prisma (from Supabase Settings -> Database -> Connection string)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Session and secrets
SESSION_SECRET=your-secret-key-here
NODE_ENV=development

# Directories
RECEIPT_DIR=./receipts
UPLOAD_DIR=./uploads

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Telegram Link (for upgrade page)
VITE_TELEGRAM_LINK=https://t.me/your-telegram-username

# Optional: Email Configuration (for receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
